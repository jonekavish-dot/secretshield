# Copy to .env and fill in real values. NEVER commit .env.
#
# Generate a token with:  python3 -c "import secrets; print('sshield_' + secrets.token_hex(16))"
INGEST_TOKEN=

# Where the service stores its data inside the container.
DB_PATH=/srv/data/secretshield.db
LOG_PATH=/srv/logs/secretshield.log
